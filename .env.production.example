# Production / cloud Supabase — public client config (safe to ship; RLS protects data).
# Copy to `.env.production` for local prod builds, OR set these in Vercel and EAS.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Server-only — NEVER ship in the app. Used only by scripts/seed.mjs to seed
# a cloud project. Set it in your shell when seeding, do not commit.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
