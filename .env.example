# Supabase — public client config (safe to ship; RLS protects data).
# Create a project at https://supabase.com, then copy these from
# Project Settings -> API. Copy this file to `.env` and fill in.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional web map rendering. Restrict this public key to your app domains in
# Google Cloud. Without it, the app uses the built-in chart map fallback.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_USE_MATCH_EDGE_FUNCTIONS=false
